<Window x:Class="Velo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velo Desktop Receiver" Height="680" Width="720"
        Background="#0F172A" Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" MinHeight="520" MinWidth="580">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="14" Height="14" CornerRadius="7" x:Name="StatusDot" Background="#10B981" Margin="0,0,10,0"/>
                <TextBlock Text="Velo" FontSize="26" FontWeight="Black" Foreground="#38BDF8"/>
                <TextBlock Text="Desktop Receiver" FontSize="26" FontWeight="Light" Foreground="#94A3B8" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="Available (Listening on :51821)" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <Button Content="About &amp; Credits" Click="BtnAbout_Click" Background="#1E293B" Foreground="#38BDF8" Margin="12,0,0,0" Padding="10,6" FontSize="12"/>
            </StackPanel>
        </DockPanel>

        <!-- Pairing Code Card -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PAIRING CODE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtPairingCode" Text="------" FontSize="36" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                    <TextBlock Text="Enter this 6-digit code on the Velo Remote Android app to authorize connection." FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="New Code" Click="BtnNewCode_Click" Background="#0284C7" Margin="0,0,0,8"/>
                    <Button Content="Reset All" Click="BtnResetPairing_Click" Background="#DC2626"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Device & Network Status Card -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CONNECTED CLIENT" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtConnectedDevice" Text="None (Waiting for device)" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtPairedCount" Text="Paired devices: 0" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="LOCAL NETWORK" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtLocalIp" Text="IP: Detecting..." FontSize="13" Foreground="#E2E8F0"/>
                    <TextBlock Text="WebSocket Port: 51821 | UDP Port: 51820" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Diagnostics Logs -->
        <Border Grid.Row="3" Background="#090D16" CornerRadius="12" Padding="14" BorderBrush="#1E293B" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="DIAGNOSTICS &amp; EVENT LOG" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Clear" Click="BtnClearLogs_Click" Background="Transparent" Foreground="#64748B" Padding="8,4" FontSize="11"/>
                </DockPanel>
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLogs" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" 
                             IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="Velo Desktop Receiver v1.0 • Ultra-Responsive PC Remote • 100% Offline LAN" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Minimize to Tray" Click="BtnMinimizeToTray_Click" Background="#1E293B"/>
        </DockPanel>
    </Grid>
</Window>
