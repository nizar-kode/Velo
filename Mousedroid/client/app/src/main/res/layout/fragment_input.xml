<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_space_glass">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Modern Top Bar -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Drawer Button -->
                <ImageButton
                    android:id="@+id/btnOpenDrawer"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/glass_button_default"
                    android:padding="8dp"
                    android:src="@drawable/ic_menu"
                    app:tint="#CBD5E1" />

                <!-- Connection Status Pill -->
                <LinearLayout
                    android:id="@+id/connectionStatusPill"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/glass_card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/circle_green" />

                    <TextView
                        android:id="@+id/txtHostStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Connected"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Quick Disconnect Button -->
                <ImageButton
                    android:id="@+id/btnQuickDisconnect"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/glass_button_default"
                    android:padding="8dp"
                    android:src="@drawable/ic_disconnect"
                    app:tint="#F43F5E" />
            </LinearLayout>

            <!-- Main Fragment Hosting Container -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragment_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/topBar"
                app:layout_constraintBottom_toTopOf="@+id/bottomNavCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Floating Glass Bottom Navigation Pill Bar -->
            <FrameLayout
                android:id="@+id/bottomNavCard"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/glass_bottom_nav_bg"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <!-- Tab 1: Trackpad -->
                    <LinearLayout
                        android:id="@+id/btnNavTouchpad"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_nav_item_active"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iconNavTouchpad"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_touchpad"
                            app:tint="#38BDF8" />

                        <TextView
                            android:id="@+id/labelNavTouchpad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Trackpad"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tab 2: Presenter -->
                    <LinearLayout
                        android:id="@+id/btnNavPresenter"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iconNavPresenter"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_presentation"
                            app:tint="#94A3B8" />

                        <TextView
                            android:id="@+id/labelNavPresenter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Presenter"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Tab 3: Shortcuts -->
                    <LinearLayout
                        android:id="@+id/btnNavShortcuts"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iconNavShortcuts"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_baseline_keyboard_24"
                            app:tint="#94A3B8" />

                        <TextView
                            android:id="@+id/labelNavShortcuts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Shortcuts"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Tab 4: Media -->
                    <LinearLayout
                        android:id="@+id/btnNavMedia"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iconNavMedia"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_play"
                            app:tint="#94A3B8" />

                        <TextView
                            android:id="@+id/labelNavMedia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Media"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- Hidden Input for IME Soft Keyboard -->
            <EditText
                android:id="@+id/hiddenInput"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:alpha="0"
                android:visibility="visible"
                android:translationX="-500dp"
                android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword"
                android:imeOptions="actionNone"
                android:background="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Navigation Drawer for Advanced Settings & Layouts -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigation"
            style="@style/Widget.Mousedroid.NavigationView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#101422"
            app:headerLayout="@layout/nav_header_mousedroid"
            app:menu="@menu/input_modes_menu" />

    </androidx.drawerlayout.widget.DrawerLayout>
</layout>