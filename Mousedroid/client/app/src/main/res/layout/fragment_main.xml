<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".fragments.Main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_space_glass"
        android:padding="24dp">

        <!-- Logo & Branding -->
        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo"
            app:layout_constraintBottom_toTopOf="@+id/textViewTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Mousedroid"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/textView2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView2" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Turn your phone into a Trackpad &amp; Air Laser"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/btnConnectSV"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewTitle" />

        <!-- Primary Glass Card: Wi-Fi Remote (Auto-Connect) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnectSV"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:background="@drawable/glass_card_active"
            android:elevation="0dp"
            android:gravity="center"
            android:paddingVertical="20dp"
            android:paddingHorizontal="24dp"
            android:text="Wi-Fi Remote (Auto-Connect)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/desktop_icon"
            app:iconGravity="textStart"
            app:iconPadding="14dp"
            app:iconSize="24dp"
            app:iconTint="#38BDF8"
            app:layout_constraintBottom_toTopOf="@+id/bluetoothRow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView2" />

        <!-- Bluetooth Row: Glass Connection Button + Glass Pair Button -->
        <LinearLayout
            android:id="@+id/bluetoothRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnConnectSV">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnectBT"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/glass_card"
                android:elevation="0dp"
                android:gravity="center"
                android:paddingVertical="18dp"
                android:paddingHorizontal="16dp"
                android:text="Bluetooth"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="16sp"
                app:backgroundTint="@null"
                app:icon="@drawable/baseline_bluetooth_24"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="22dp"
                app:iconTint="#A78BFA" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPairBT"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_button_default"
                android:elevation="0dp"
                android:gravity="center"
                android:paddingVertical="18dp"
                android:paddingHorizontal="20dp"
                android:text="Pair"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="16sp"
                app:backgroundTint="@null" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>