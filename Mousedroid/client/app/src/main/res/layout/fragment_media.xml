<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_space_glass"
        android:padding="20dp">

        <!-- Top Header -->
        <TextView
            android:id="@+id/txtMediaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Media Controller"
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Media Hero Card -->
        <LinearLayout
            android:id="@+id/cardMediaHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            app:layout_constraintTop_toBottomOf="@id/txtMediaTitle">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_play"
                app:tint="#38BDF8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-bold"
                android:text="DESKTOP AUDIO / VIDEO"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Windows Global Media Keys"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Primary Playback Controls Deck -->
        <LinearLayout
            android:id="@+id/playbackDeck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/cardMediaHero">

            <!-- Skip Previous -->
            <ImageButton
                android:id="@+id/btnMediaPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/glass_button_default"
                android:padding="14dp"
                android:src="@drawable/ic_skip_previos"
                app:tint="#CBD5E1" />

            <!-- Large Center Play/Pause -->
            <ImageButton
                android:id="@+id/btnMediaPlayPause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/glass_button_primary"
                android:padding="18dp"
                android:src="@drawable/ic_play_pause"
                app:tint="#FFFFFF" />

            <!-- Skip Next -->
            <ImageButton
                android:id="@+id/btnMediaNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/glass_button_default"
                android:padding="14dp"
                android:src="@drawable/ic_skip_next"
                app:tint="#CBD5E1" />
        </LinearLayout>

        <!-- Seek Controls: Replay 10s / Forward 10s -->
        <LinearLayout
            android:id="@+id/seekDeck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/playbackDeck">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaReplay10"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/glass_button_default"
                android:elevation="0dp"
                android:paddingHorizontal="18dp"
                android:text="⏪ 10s Back"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediaForward10"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/glass_button_default"
                android:elevation="0dp"
                android:paddingHorizontal="18dp"
                android:text="10s Ahead ⏩"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Volume Glass Card -->
        <LinearLayout
            android:id="@+id/cardVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/seekDeck">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="VOLUME CONTROL"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMediaVolDown"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/glass_button_default"
                    android:src="@drawable/ic_volume_down"
                    app:tint="#38BDF8" />

                <ImageButton
                    android:id="@+id/btnMediaVolOff"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/glass_button_default"
                    android:src="@drawable/ic_volume_off"
                    app:tint="#F43F5E" />

                <ImageButton
                    android:id="@+id/btnMediaVolUp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_default"
                    android:src="@drawable/ic_volume_up"
                    app:tint="#38BDF8" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
