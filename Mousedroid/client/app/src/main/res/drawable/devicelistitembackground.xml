<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3038BDF8">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#1A243858"
                android:centerColor="#14182840"
                android:endColor="#0F101A2C"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#3538BDF8" />
        </shape>
    </item>
</ripple>