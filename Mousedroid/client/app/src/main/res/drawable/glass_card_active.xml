<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4038BDF8">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="135"
                android:startColor="#2538BDF8"
                android:centerColor="#151E293B"
                android:endColor="#100F172A"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#8038BDF8" />
        </shape>
    </item>
</ripple>
