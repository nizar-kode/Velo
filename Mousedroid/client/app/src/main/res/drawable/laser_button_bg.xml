<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#80EF4444">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#33EF4444"
                android:centerColor="#1AEF4444"
                android:endColor="#0DEF4444"
                android:type="radial"
                android:gradientRadius="100dp" />
            <stroke
                android:width="2dp"
                android:color="#CCEF4444" />
        </shape>
    </item>
</ripple>
